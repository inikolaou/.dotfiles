[credential "https://dev.azure.com"]
        useHttpPath = true
[credential]
        helper = store
[user]
	email = 57598729+inikolaou@users.noreply.github.com
	name = Ioannis Nikolaou
	signingkey = ~/.ssh/github-sign.pub
[commit]
	gpgsign = true
[gpg]
	format = ssh
[help]
	autocorrect = 20
[fetch]
	prune = true
# One identity per client folder; the includeIf lines are in ~/clients/gitconfig-includes (not public)
[include]
    path = ~/clients/gitconfig-includes
